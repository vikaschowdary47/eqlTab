# Supabase project (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Needed only for the inbound-email webhook. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Auto Bills email forwarding (optional; leave blank to use PDF upload only)
NEXT_PUBLIC_INBOUND_EMAIL_DOMAIN=bills.eqltab.com
INBOUND_WEBHOOK_SECRET=

# Import from Splitwise (screenshot reading). Server only: never prefix with NEXT_PUBLIC_.
GEMINI_API_KEY=
# Optional; defaults to gemini-3.1-flash-lite
GEMINI_MODEL=

# Gmail connection. Server only; never expose the secret to the browser.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3001/api/google/gmail/callback
# Optional; defaults to a hash of SUPABASE_SERVICE_ROLE_KEY.
GMAIL_TOKEN_ENCRYPTION_KEY=
# Optional; used to sign the OAuth state cookie.
GMAIL_OAUTH_STATE_SECRET=
